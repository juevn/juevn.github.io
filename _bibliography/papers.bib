@article{kim2026hiq,
  title={Hi-Q: Hierarchical Evidence-guided Query Refinement for Multi-Hop Question Answering},
  author={Kim, Jueun and Park, Sungho and Han, Wook-Shin},
  abstract={A central bottleneck in multi-hop QA is that the granularity at which a question is expressed differs from the granularity at which corpus evidence is retrievable. We formulate this as retrievable granularity discovery and introduce Hi-Q, an evidence-conditioned framework for hierarchical query refinement that grows a query tree whose topology is determined by corpus support signals rather than by a fixed decomposition template or a pre-built graph.},
  journal={arXiv preprint arXiv:2608.30468},
  year={2026},
  arxiv={2608.30468},
  website={https://hi-q-project.github.io/},
  preview={hi-q.webp},
  dimensions={true},
  selected={true}
}

@article{park2025sparta,
  title={SPARTA: Scalable and Principled Benchmark of Tree-Structured Multi-hop QA over Text and Tables},
  author={Park, Sungho and Kim, Jueun and Han, Wook-Shin},
  abstract={SPARTA is a fully automated SQL-centric pipeline that constructs a tree-structured multi-hop QA benchmark by unifying structured and unstructured evidence from tables and text into a single relational representation.},
  journal={The Fourteenth International Conference on Learning Representations(ICLR)},
  year={2026},
  arxiv={2602.23286},
  website={https://sparta-projectpage.github.io/},
  dimensions={true},
  preview={sparta.webp},
  selected={true}
}
