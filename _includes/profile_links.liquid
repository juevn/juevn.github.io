{%- comment -%}
  Labelled links under the profile photo. Styled with the same button classes as
  the publication links so the page keeps one button vocabulary.

  Handles live in _data/socials.yml; a row here is what turns one into a button,
  so adding a new link means editing both files.
{%- endcomment -%}
{%- assign s = site.data.socials -%}
<div class="profile-links">
  {%- if s.email %}
    <a href="mailto:{{ s.email }}" class="btn btn-sm z-depth-0" role="button">
      <i class="fa-solid fa-envelope"></i> Email
    </a>
  {%- endif %}
  {%- if s.scholar_userid %}
    <a
      href="https://scholar.google.com/citations?user={{ s.scholar_userid }}"
      class="btn btn-sm z-depth-0"
      role="button"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="ai ai-google-scholar"></i> Scholar
    </a>
  {%- endif %}
  {%- if s.github_username %}
    <a
      href="https://github.com/{{ s.github_username }}"
      class="btn btn-sm z-depth-0"
      role="button"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-brands fa-github"></i> GitHub
    </a>
  {%- endif %}
  {%- if s.x_username %}
    <a
      href="https://twitter.com/{{ s.x_username }}"
      class="btn btn-sm z-depth-0"
      role="button"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-brands fa-x-twitter"></i> X
    </a>
  {%- endif %}
  {%- if s.linkedin_username %}
    <a
      href="https://www.linkedin.com/in/{{ s.linkedin_username }}"
      class="btn btn-sm z-depth-0"
      role="button"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i class="fa-brands fa-linkedin"></i> LinkedIn
    </a>
  {%- endif %}
</div>
